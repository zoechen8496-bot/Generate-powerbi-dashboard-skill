		summarizeBy: sum
		sourceColumn: YearMonthSort

		annotation SummarizationSetBy = Automatic

	partition DimMonth = m
		mode: import
		source =
				let
				    Source = DimDate,
				    SelectMonthColumns = Table.SelectColumns(Source, {"Year", "MonthNo", "Month", "MonthName"}),
				    DistinctMonths = Table.Distinct(SelectMonthColumns, {"Month"}),
				    AddMonthStart = Table.AddColumn(DistinctMonths, "MonthStart", each #date([Year], [MonthNo], 1), type date),
				    AddYearMonthSort = Table.AddColumn(AddMonthStart, "YearMonthSort", each [Year] * 100 + [MonthNo], Int64.Type),
				    Reordered = Table.ReorderColumns(AddYearMonthSort, {"Month", "MonthStart", "Year", "MonthNo", "MonthName", "YearMonthSort"}),
				    Sorted = Table.Sort(Reordered, {{"YearMonthSort", Order.Ascending}})
				in
				    Sorted

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

