		summarizeBy: none
		sourceColumn: MonthStart

		variation Variation
			isDefault
			relationship: 2fa7b347-bcac-44c4-832a-b409220b468a
			defaultHierarchy: LocalDateTable_a1be8bdc-7f7f-46a2-8d62-6e3c853ee9c0.'Date Hierarchy'

